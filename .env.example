# Copy this file to .env and fill in real values. Never commit .env.

# Required: secret used to sign dashboard auth tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECUREBOT_SECRET_KEY=

# Required: dashboard login credentials.
SECUREBOT_ADMIN_USER=admin
SECUREBOT_ADMIN_PASSWORD=

# Optional overrides (defaults shown).
#SECUREBOT_MQTT_HOST=localhost
#SECUREBOT_MQTT_PORT=1883
#SECUREBOT_MQTT_TOPIC=securebot/telemetry
#SECUREBOT_DB_FILE=~/securebot.db
#SECUREBOT_SERIAL_PORT=/dev/ttyACM0
#SECUREBOT_BAUD_RATE=115200
#SECUREBOT_DASHBOARD_HOST=0.0.0.0
#SECUREBOT_DASHBOARD_PORT=5000
#SECUREBOT_TOKEN_TTL=3600
